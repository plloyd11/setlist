# Supabase project URL
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable key (Project Settings -> API Keys -> publishable key)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: TONE3000 publishable key (tone3000.com/settings -> API keys), so the practice
# rig can browse NAM captures and IRs. Register <origin>/auth/tone3000 as a redirect URI.
PUBLIC_TONE3000_CLIENT_ID=
